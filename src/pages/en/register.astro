---
import Layout from '../../layouts/Layout.astro';

const registrationUrl = 'https://sudhana.net/lien-tam-luostari/khoa-tu-phat-that-tai-bo-e-ao-trang-an-o/register';
---

<Layout title="Register | 7-Day Phật Thất Retreat at Bodh Gaya">
    <section class="max-w-5xl py-16 space-y-10">
        <div>
            <p class="mb-3 text-sm uppercase tracking-[0.2em] text-neutral-500">Register</p>
            <h1 class="mb-6">Registration Information</h1>
            <p class="max-w-3xl text-lg leading-8 text-neutral-700">
                We warmly invite both lay Buddhists and venerable monastics to register for the 7-Day Phật Thất Retreat at Bodh Gaya using the link below. You
                may also contact us for more information about the optional pilgrimage, accommodation, and local arrangements.
            </p>
        </div>

        <div class="rounded-2xl border-2 border-amber-400 bg-white p-6">
            <p class="text-lg leading-8 text-neutral-800">
                The registration deadline is 00:00 on September 30, 2026. We have been able to arrange a bit more space for participants, and there are
                currently <strong>10 places left for lay Buddhists</strong>. The registration system will close once all places are filled. Therefore, we
                kindly encourage you to register as early as possible.
            </p>
        </div>

        <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-6">
            <h2 class="mb-4">Contact</h2>
            <p class="leading-8 text-neutral-700">
                If you need more information about registration, accommodation, the pilgrimage, or local arrangements, please contact the organizing team by
                email at: <a href="mailto:bodhi-retreat@web.de">bodhi-retreat@web.de</a>
            </p>
            <p class="mt-4 leading-8 text-neutral-700">
                Please use email whenever possible. If you are unable to use email, you may also contact the organizing team directly:
            </p>
            <ul class="mt-2 space-y-2 leading-8 text-neutral-700">
                <li>Germany: Thầy Thông Kiên or Sư cô Thông Chu</li>
                <li>Finland: Thầy Thông Tuệ</li>
            </ul>
        </div>

        <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-6">
            <h2 class="mb-4">Registration Notes</h2>
            <p class="leading-8 text-neutral-700">
                Please fill in the registration form as completely as possible. The organizing team will follow up if additional details are needed regarding
                the retreat or the optional 4-day pilgrimage.
            </p>
        </div>

        <div class="rounded-2xl border-2 border-amber-400 bg-white p-6 md:p-8">
            <h2 class="mb-4">Registration form</h2>
            <p class="leading-8 text-neutral-700">
                Please register here:
                <a href={registrationUrl} target="_blank" rel="noreferrer">{registrationUrl}</a>
            </p>
            <a href={registrationUrl} target="_blank" rel="noreferrer" class="btn btn-lg mt-5">Register now</a>
        </div>
    </section>
</Layout>
